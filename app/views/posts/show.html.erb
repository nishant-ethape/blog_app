<h1><%= @post.title %></h1>
<p><%= @post.body %></p>

<hr>

<h3>Comments</h3>
<% @post.comments.each do |comment| %>
  <div>
    <p><%= comment.body %></p>
  </div>
<% end %>

<h3>Add a Comment</h3>
<%= form_with model: [@post, @comment] do |f| %>
  <div>
    <%= f.label :body, "Comment" %>
    <%= f.text_area :body %>
  </div>
  <%= f.submit "Post Comment" %>
<% end %>

<%= link_to "Back to Posts", posts_path %>